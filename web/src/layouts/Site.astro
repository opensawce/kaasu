---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/tokens.css';
import '../styles/site.css';
import Mark from '../components/Mark.astro';

interface Props { title: string; description: string; jsonLd?: object[]; noindex?: boolean }
const { title, description, jsonLd = [], noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const og = `${site}${base}/img/social-preview.png`;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site ?? 'https://kaasu.opensawce.com').toString();
const nav = [
  ['Docs', `${base}/docs/`],
  ['Terms', `${base}/terms/`],
  ['GitHub', 'https://github.com/opensawce/kaasu'],
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content={noindex ? 'noindex' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
  <meta name="theme-color" content="#0F7B5F" />
  <meta name="author" content="OpenSawce" />
  <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
  <link rel="alternate" type="text/plain" href={`${base}/llms.txt`} title="LLM summary" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Kaasu" />
  <meta property="og:locale" content="en_IN" />
  <meta property="og:url" content={canonical} />
  <meta property="og:image:width" content="1280" />
  <meta property="og:image:height" content="640" />
  <meta property="og:image:alt" content="Kaasu: confirm UPI payments without touching the money" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={og} />
  <meta name="twitter:card" content="summary_large_image" />
  {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...d })} />)}
  <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="nav">
    <div class="wrap nav-in">
      <a class="brand" href={`${base}/`}><Mark size={32} /><span>kaasu</span></a>
      <nav aria-label="Main">
        {nav.map(([label, href]) => <a href={href} aria-current={path.startsWith(href) && href !== `${base}/` ? 'page' : undefined}>{label}</a>)}
      </nav>
    </div>
  </header>
  <main id="main"><slot /></main>
  <footer class="foot">
    <div class="wrap foot-in">
      <div>
        <a class="brand" href={`${base}/`}><Mark size={28} /><span>kaasu</span></a>
        <p>Confirm UPI payments without touching the money.</p>
        <p class="small">Built by OpenSawce, Bengaluru.</p>
      </div>
      <div>
        <h3>Learn</h3>
        <a href={`${base}/docs/`}>Documentation</a>
        <a href={`${base}/docs/start/install/`}>Install</a>
        <a href={`${base}/docs/reference/security/`}>Security</a>
      </div>
      <div>
        <h3>Project</h3>
        <a href="https://github.com/opensawce/kaasu">GitHub</a>
        <a href="https://github.com/opensawce/kaasu/issues">Roadmap and issues</a>
        <a href="https://github.com/opensawce/kaasu/blob/main/CONTRIBUTING.md">Contributing</a>
      </div>
      <div>
        <h3>Legal</h3>
        <a href={`${base}/terms/`}>Terms</a>
        <a href="https://github.com/opensawce/kaasu/blob/main/LICENSE">Licence</a>
        <a href="https://github.com/opensawce/kaasu/blob/main/CLA.md">Contributor agreement</a>
      </div>
    </div>
  </footer>
</body>
</html>
